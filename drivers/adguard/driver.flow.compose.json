    {
      "id": "add_filter_list",
      "title": {
        "en": "Add a filter list",
        "nl": "Een filterlijst toevoegen"
      },
      "titleFormatted": {
        "en": "Add [[type]] [[name]] with URL [[url]]",
        "nl": "Voeg [[type]] [[name]] toe met URL [[url]]"
      },
      "args": [
        {
          "type": "dropdown",
          "name": "type",
          "title": {
            "en": "Type",
            "nl": "Type"
          },
          "values": [
            {
              "id": "block",
              "title": {
                "en": "blocklist",
                "nl": "blokkeerlijst"
              }
            },
            {
              "id": "allow",
              "title": {
                "en": "allowlist",
                "nl": "toestaanlijst"
              }
            }
          ]
        },
        {
          "type": "text",
          "name": "name",
          "title": {
            "en": "Name",
            "nl": "Naam"
          },
          "placeholder": {
            "en": "My list",
            "nl": "Mijn lijst"
